NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mukhija_clinic
AUTH_SECRET=change-me-to-a-long-random-string
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_NAME=Mukhija Skin & Laser Clinic

# Email — GoDaddy Professional Email (SMTP)
# Set EMAIL_PROVIDER=console to log only; smtp to send for real.
EMAIL_PROVIDER=smtp
EMAIL_FROM=appointments@drmukhijaskinclinic.com
EMAIL_REPLY_TO=appointments@drmukhijaskinclinic.com
EMAIL_STAFF_TO=appointments@drmukhijaskinclinic.com
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=appointments@drmukhijaskinclinic.com
SMTP_PASS=your-mailbox-password-here

WHATSAPP_PROVIDER=console
