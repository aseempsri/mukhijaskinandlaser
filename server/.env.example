NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mukhija_clinic
AUTH_SECRET=change-me-to-a-long-random-string
DASHBOARD_EMAIL=doctor@mukhijaskinclinic.com
DASHBOARD_PASS=change-me-to-a-strong-dashboard-password
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_NAME=Mukhija Skin & Laser Clinic

# Email — GoDaddy Professional Email (SMTP)
# Set EMAIL_PROVIDER=console to log only; smtp to send for real.
EMAIL_PROVIDER=smtp
EMAIL_FROM=appointments@drmukhijaskinclinic.com
EMAIL_REPLY_TO=appointments@drmukhijaskinclinic.com
EMAIL_STAFF_TO=appointments@drmukhijaskinclinic.com
# GoDaddy Professional Email powered by Titan
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=appointments@drmukhijaskinclinic.com
SMTP_PASS=your-mailbox-password-here

# WhatsApp — Meta Cloud API
# Set WHATSAPP_PROVIDER=console to log only; meta to send for real.
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=1215959628278103
WHATSAPP_BUSINESS_ACCOUNT_ID=2112569092945195
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_REQUESTED=appointment_request_received
WHATSAPP_TEMPLATE_APPROVED=appointment_approved
WHATSAPP_TEMPLATE_REJECTED=appointment_rejected
WHATSAPP_TEMPLATE_RESCHEDULE=appointment_reschedule
WHATSAPP_TEMPLATE_STAFF_NEW=staff_new_appointment
# Optional clinic WhatsApp for staff alerts (else uses doctor.whatsappNumber)
WHATSAPP_STAFF_TO=919554220700
